# ===== ai-analyst 認証情報テンプレート =====
# このファイルを `.env` にコピーして値を埋めてください。
# .env は .gitignore 済み。絶対にコミットしないこと。

# --- J-Quants (https://jpx-jquants.com/) ---
# 方法A: リフレッシュトークンを直接設定(推奨・有効期限に注意)
JQUANTS_REFRESH_TOKEN=

# 方法B: メール+パスワードから自動取得(リフレッシュトークン未設定時に使用)
JQUANTS_MAILADDRESS=
JQUANTS_PASSWORD=

# --- Discord 通知 (チャンネル設定 → 連携 → Webhook で発行) ---
DISCORD_WEBHOOK_URL=
# アラート用に別チャンネルのWebhookを使う場合(任意)
DISCORD_ALERT_WEBHOOK_URL=

# --- Obsidian (Phase 5) ---
# mcp-obsidian 未導入時のフォールバック用に Vault パスを指定
OBSIDIAN_VAULT_PATH=

# --- 注意 ---
# サブスク(Pro/Max)で使う場合、従量課金に化けないよう ANTHROPIC_API_KEY は設定しないこと。
