{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(python3:*)",
      "Bash(./scripts/notify.sh:*)",
      "Bash(./scripts/run_daily.sh:*)",
      "Bash(source:*)",
      "Bash(ls:*)",
      "Bash(cat reports/*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(*ANTHROPIC_API_KEY*)"
    ]
  }
}
