# ===== ai-business-radar 認証情報テンプレート =====
# `.env` にコピーして埋める。APIキーはコードに直書きしないこと。.env は .gitignore 済み。
#
# J-Quants を使う場合のみ設定(未設定でもローカルCSVで動きます)。
# 優先順: JQUANTS_ID_TOKEN > JQUANTS_REFRESH_TOKEN > JQUANTS_API_KEY > メール/パスワード

# リフレッシュトークン(JQUANTS_API_KEY としても可)
JQUANTS_API_KEY=
JQUANTS_REFRESH_TOKEN=

# もしくはメール+パスワード(リフレッシュトークン未設定時に使用)
JQUANTS_MAILADDRESS=
JQUANTS_PASSWORD=

# 取得済みの idToken を直接使う場合(任意)
JQUANTS_ID_TOKEN=
